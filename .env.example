# Copy this file to .env (or .env.local) and fill in real values there.
# .env / .env.local are gitignored — never commit real credentials.

# Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Name of the httpOnly session cookie set on staff login.
SESSION_COOKIE_NAME="nuru_session"

# Used once by `prisma db seed` to bootstrap the first Owner account.
# Not read at runtime after the initial seed.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-before-seeding"

# RustFS (S3-compatible object storage for product images). Run locally with
# `docker compose up -d rustfs` — see docker-compose.yml. Defaults below match
# that file; change them if you point at a different RustFS instance.
RUSTFS_ENDPOINT="http://localhost:9000"
RUSTFS_ACCESS_KEY="rustfsadmin"
RUSTFS_SECRET_KEY="rustfsadmin"
RUSTFS_BUCKET="nuru-media"
# Base URL used to build public image URLs. In dev this is the same as
# RUSTFS_ENDPOINT; in production it would be a real domain in front of the bucket.
RUSTFS_PUBLIC_URL="http://localhost:9000"
