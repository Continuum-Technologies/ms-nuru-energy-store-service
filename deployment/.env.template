# =============================================================================
# Nuru Energy Store — production environment
# =============================================================================
# Copy to `.env` in this same directory (deployment/.env), fill in every
# value, then `chmod 600 .env`. This file is sourced by deploy.sh and
# scripts/remote-deploy.sh with `set -a` before every `docker stack deploy` —
# Swarm mode does not read `env_file:` in the compose file itself, so every
# ${VAR} placeholder there is resolved from whatever is exported when you run
# deploy.sh. Never commit the real .env.
# =============================================================================

# Where deploy.sh creates bind-mount directories for Postgres/RustFS/Traefik
# state. Must have enough disk for the database and all product images.
DATA_DIR=/opt/nuru-data

# Let's Encrypt account email — required by Traefik's ACME resolver, used
# only for renewal/expiry notices, never shown to customers.
ACME_EMAIL=lispermichaels@gmail.com

# Postgres — generate with: openssl rand -hex 24
POSTGRES_PASSWORD=lispermichaels

# RustFS (S3-compatible object storage) credentials — generate with:
# openssl rand -hex 16 (access key) and openssl rand -hex 32 (secret key)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
# Traefik dashboard basic-auth credential — "user:hash" using an apr1/bcrypt
# hash, NOT a plaintext password. Generate with:
#   htpasswd -nB admin        (needs apache2-utils; prompts for a password)
# or, if htpasswd isn't installed:
#   openssl passwd -apr1
# then combine as "admin:<hash-it-printed>". MUST be single-quoted below —
# the hash contains literal $ characters that `source .env` would otherwise
# try to expand as shell variables.
TRAEFIK_DASHBOARD_AUTH='admin:$apr1$REPLACE$ME'

# Docker Hub image this stack pulls — must match what
# .github/workflows/build-and-publish.yml pushes.
DOCKER_IMAGE=shamirj/nuru-energy-store
# Set by CI on every deploy (docker stack deploy NURU_VERSION=<tag> ...).
# Only needed here for a manual `docker stack deploy` from this host.
NURU_VERSION=latest

# One-time use by `npx prisma db seed` (scripts/migrate.sh) to bootstrap the
# first Owner account. Not read at runtime after the initial seed — rotate
# the Owner's password from inside the admin dashboard afterwards.
OWNER_EMAIL=lispermichaels@gmail.com
OWNER_PASSWORD=Jumia@2025
