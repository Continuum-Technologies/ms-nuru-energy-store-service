enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
  AVAILABLE_ON_ORDER
  DISCONTINUED
  ARCHIVED

  @@schema("nuru")
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  imageUrl     String?
  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  parentId     String?
  children     Category[] @relation("CategoryParent")
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  isFeatured   Boolean    @default(false)

  // SEO fields are embedded per entity rather than a polymorphic table — see
  // CLAUDE.md "Implementation conventions".
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?

  products               Product[]
  specificationTemplates SpecificationTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
  @@schema("nuru")
}

model Brand {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  logoUrl         String?
  description     String?
  countryOfOrigin String?
  websiteUrl      String?
  isActive        Boolean @default(true)
  isFeatured      Boolean @default(false)

  seoTitle       String?
  seoDescription String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
  @@schema("nuru")
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  model            String?
  shortDescription String?
  fullDescription  String?
  status           ProductStatus @default(DRAFT)

  sellingPrice    Decimal  @db.Decimal(12, 2)
  previousPrice   Decimal? @db.Decimal(12, 2)
  costPrice       Decimal? @db.Decimal(12, 2)
  isQuotationOnly Boolean  @default(false)
  hidePrice       Boolean  @default(false)

  weightKg              Decimal? @db.Decimal(10, 2)
  dimensions            String?
  installationAvailable Boolean  @default(false)
  installationRequired  Boolean  @default(false)

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String
  brand      Brand?   @relation(fields: [brandId], references: [id])
  brandId    String?

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?

  images             ProductImage[]
  specifications     ProductSpecification[]
  inventoryItem      InventoryItem?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  quotationItems     QuotationItem[]
  inventoryMovements InventoryMovement[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
  @@schema("nuru")
}

model ProductImage {
  id           String   @id @default(cuid())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  url          String
  // The RustFS object key (see src/infrastructure/storage/upload.ts) — kept
  // alongside url so a delete can target the exact object instead of
  // re-deriving it by parsing the URL.
  key          String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
  @@map("product_images")
  @@schema("nuru")
}

// Category-driven, reusable spec definitions — specs are structured data, not
// free text (CLAUDE.md §4).
model SpecificationTemplate {
  id         String               @id @default(cuid())
  name       String
  category   Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  fields     SpecificationField[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([categoryId])
  @@map("specification_templates")
  @@schema("nuru")
}

model SpecificationField {
  id           String                 @id @default(cuid())
  template     SpecificationTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId   String
  label        String
  unit         String?
  displayOrder Int                    @default(0)
  values       ProductSpecification[]

  @@index([templateId])
  @@map("specification_fields")
  @@schema("nuru")
}

model ProductSpecification {
  id        String             @id @default(cuid())
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  field     SpecificationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId   String
  value     String

  @@unique([productId, fieldId])
  @@index([productId])
  @@map("product_specifications")
  @@schema("nuru")
}
