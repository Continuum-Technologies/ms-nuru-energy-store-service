enum PaymentMethod {
  MPESA_STK_PUSH
  MPESA_TILL
  MPESA_PAYBILL
  BANK_TRANSFER
  CASH_ON_DELIVERY
  PAYMENT_ON_COLLECTION
  MANUAL

  @@schema("nuru")
}

enum PaymentStatus {
  PENDING
  INITIATED
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  EXPIRED
  VERIFICATION_REQUIRED
  PARTIALLY_PAID
  REFUNDED
  PARTIALLY_REFUNDED

  @@schema("nuru")
}

// providerReference is unique so a repeated payment-provider callback cannot
// create a duplicate payment row — enforced at the DB level, not just in
// application code (CLAUDE.md §4 payment-idempotency rule).
model Payment {
  id                String        @id @default(cuid())
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  reference         String        @unique
  method            PaymentMethod
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("KES")
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerReference String?       @unique
  paidAt            DateTime?
  verifiedAt        DateTime?
  recordedBy        AdminUser?    @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById      String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("payments")
  @@schema("nuru")
}
